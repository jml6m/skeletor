{
  "id": "log-table",
  "name": "Terminal-width-aware log tables",
  "description": "cli-table3 + string-width log table utility with display-width truncation and config defaults.",
  "version": "1.0.0",
  "appliesTo": {
    "languages": [
      "javascript",
      "typescript"
    ],
    "templates": [
      "javascript",
      "typescript"
    ]
  },
  "files": {
    "dir": "files",
    "overwrite": false,
    "onConflict": "skip"
  },
  "patch": {
    "packageJson": {
      "javascript": "patch/package.javascript.json",
      "typescript": "patch/package.typescript.json"
    }
  },
  "docs": {
    "agents": {
      "section": "Log tables",
      "append": "docs/AGENTS.snippet.md"
    }
  },
  "knip": {
    "entry": [
      "src/utils/logTable.{js,ts}"
    ]
  }
}
