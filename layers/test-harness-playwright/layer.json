{
  "id": "test-harness:playwright",
  "name": "Playwright E2E harness",
  "description": "Minimal Playwright setup: a config with one Chromium project, an example spec, and test:e2e scripts.",
  "version": "1.0.0",
  "appliesTo": {
    "languages": ["javascript", "typescript"],
    "templates": ["javascript", "typescript"]
  },
  "files": { "dir": "files", "overwrite": false, "onConflict": "skip" },
  "gitignore": ["/playwright-report/", "/test-results/", "/blob-report/", "/playwright/.cache/"],
  "patch": { "packageJson": "patch/package.json.json" },
  "docs": {
    "agents": { "section": "End-to-end tests", "append": "docs/AGENTS.snippet.md" }
  },
  "verifyCommands": ["npm install"]
}
