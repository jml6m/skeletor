{
  "id": "test-harness:mongo-memory",
  "name": "MongoDB Memory Server test harness",
  "description": "mongodb-memory-server start/stop helpers for Jest, an example test that uses them, and a test:mongo script.",
  "version": "1.0.0",
  "appliesTo": {
    "languages": [
      "javascript",
      "typescript"
    ],
    "templates": [
      "javascript",
      "typescript"
    ]
  },
  "files": {
    "dir": "files",
    "overwrite": false,
    "onConflict": "skip"
  },
  "patch": {
    "packageJson": {
      "javascript": "patch/package.javascript.json",
      "typescript": "patch/package.typescript.json"
    }
  },
  "docs": {
    "agents": {
      "section": "Database tests",
      "append": "docs/AGENTS.snippet.md"
    }
  }
}
