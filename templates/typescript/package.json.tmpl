{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{DESCRIPTION}}",
  "main": "dist/index.js",
  "type": "module",
  "license": "{{LICENSE}}",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --verbose",
    "release:patch": "node release.js patch",
    "release:minor": "node release.js minor",
    "release:major": "node release.js major",
    "npm:reinstall": "node scripts/reinstall.js",
    "health:dead": "knip --treat-config-hints-as-errors",
    "health:circular": "madge --circular --extensions ts src",
    "report:dupes": "jscpd src"
  },
  "devDependencies": {
    "@eslint/js": "{{PIN_ESLINT_JS}}",
    "@types/jest": "{{PIN_TYPES_JEST}}",
    "@types/node": "{{PIN_TYPES_NODE}}",
    "cross-env": "{{PIN_CROSS_ENV}}",
    "eslint": "{{PIN_ESLINT}}",
    "eslint-plugin-unused-imports": "{{PIN_ESLINT_PLUGIN_UNUSED_IMPORTS}}",
    "globals": "{{PIN_GLOBALS}}",
    "husky": "{{PIN_HUSKY}}",
    "jest": "{{PIN_JEST}}",
    "jscpd": "{{PIN_JSCPD}}",
    "knip": "{{PIN_KNIP}}",
    "lint-staged": "{{PIN_LINT_STAGED}}",
    "madge": "{{PIN_MADGE}}",
    "prettier": "{{PIN_PRETTIER}}",
    "prettier-plugin-organize-imports": "{{PIN_PRETTIER_PLUGIN_ORGANIZE_IMPORTS}}",
    "prettier-plugin-pkg": "{{PIN_PRETTIER_PLUGIN_PKG}}",
    "ts-jest": "{{PIN_TS_JEST}}",
    "typescript": "{{PIN_TYPESCRIPT}}",
    "typescript-eslint": "{{PIN_TYPESCRIPT_ESLINT}}"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "lint-staged": {
    "*.{ts,js,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": "{{PIN_RUNTIME_NODE_ENGINES}}"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "{{PIN_RUNTIME_NODE_ENGINES}}",
      "onFail": "error"
    }
  }
}