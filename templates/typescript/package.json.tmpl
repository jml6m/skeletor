{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{DESCRIPTION}}",
  "main": "dist/index.js",
  "type": "module",
  "license": "{{LICENSE}}",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose",
    "release:patch": "node release.js patch",
    "release:minor": "node release.js minor",
    "release:major": "node release.js major",
    "npm:reinstall": "node scripts/reinstall.js",
    "prompt:gen": "node scripts/generate-context.js",
    "health:dead": "knip --no-exit-code",
    "health:dupes": "jscpd src || node -e \"process.exit(0)\"",
    "health:circular": "madge --circular --extensions ts src || node -e \"process.exit(0)\"",
    "health:full": "npm-run-all --sequential health:dead health:dupes health:circular"
  },
  "dependencies": {
    "module-alias": "{{PIN_MODULE_ALIAS}}"
  },
  "devDependencies": {
    "@types/node": "{{PIN_TYPES_NODE}}",
    "cross-env": "{{PIN_CROSS_ENV}}",
    "eslint": "{{PIN_ESLINT}}",
    "eslint-plugin-unused-imports": "{{PIN_ESLINT_PLUGIN_UNUSED_IMPORTS}}",
    "globals": "{{PIN_GLOBALS}}",
    "husky": "{{PIN_HUSKY}}",
    "jest": "{{PIN_JEST}}",
    "jscpd": "{{PIN_JSCPD}}",
    "knip": "{{PIN_KNIP}}",
    "lint-staged": "{{PIN_LINT_STAGED}}",
    "madge": "{{PIN_MADGE}}",
    "npm-run-all": "{{PIN_NPM_RUN_ALL}}",
    "prettier": "{{PIN_PRETTIER}}",
    "prettier-plugin-organize-imports": "{{PIN_PRETTIER_PLUGIN_ORGANIZE_IMPORTS}}",
    "prettier-plugin-pkg": "{{PIN_PRETTIER_PLUGIN_PKG}}",
    "ts-jest": "{{PIN_TS_JEST}}",
    "typescript": "{{PIN_TYPESCRIPT}}",
    "typescript-eslint": "{{PIN_TYPESCRIPT_ESLINT}}"
  },
  "imports": {
    "#*": "./src/*"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": "{{PIN_RUNTIME_NODE_ENGINES}}"
  }
}