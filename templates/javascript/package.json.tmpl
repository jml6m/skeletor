{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "description": "{{DESCRIPTION}}",
  "license": "{{LICENSE}}",
  "private": true,
  "engines": {
    "node": "{{PIN_RUNTIME_NODE_ENGINES}}"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "{{PIN_RUNTIME_NODE_ENGINES}}",
      "onFail": "error"
    }
  },
  "main": "src/index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health:circular": "madge --circular --extensions js src",
    "health:dead": "knip --treat-config-hints-as-errors",
    "lint": "eslint . --max-warnings 0",
    "npm:reinstall": "node scripts/reinstall.js",
    "prepare": "husky",
    "release:major": "node release.js major",
    "release:minor": "node release.js minor",
    "release:patch": "node release.js patch",
    "report:dupes": "jscpd src",
    "start": "node src/index.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose"
  },
  "dependencies": {
    "module-alias": "{{PIN_MODULE_ALIAS}}"
  },
  "devDependencies": {
    "@eslint/js": "{{PIN_ESLINT_JS}}",
    "eslint": "{{PIN_ESLINT}}",
    "eslint-import-resolver-typescript": "{{PIN_ESLINT_IMPORT_RESOLVER_TYPESCRIPT}}",
    "eslint-plugin-import-x": "{{PIN_ESLINT_PLUGIN_IMPORT_X}}",
    "eslint-plugin-n": "{{PIN_ESLINT_PLUGIN_N}}",
    "eslint-plugin-unused-imports": "{{PIN_ESLINT_PLUGIN_UNUSED_IMPORTS}}",
    "globals": "{{PIN_GLOBALS}}",
    "husky": "{{PIN_HUSKY}}",
    "jest": "{{PIN_JEST}}",
    "jscpd": "{{PIN_JSCPD}}",
    "knip": "{{PIN_KNIP}}",
    "lint-staged": "{{PIN_LINT_STAGED}}",
    "madge": "{{PIN_MADGE}}",
    "prettier": "{{PIN_PRETTIER}}",
    "prettier-plugin-organize-imports": "{{PIN_PRETTIER_PLUGIN_ORGANIZE_IMPORTS}}",
    "prettier-plugin-pkg": "{{PIN_PRETTIER_PLUGIN_PKG}}"
  },
  "_moduleAliases": {
    "@root": ".",
    "@src": "src",
    "@config": "src/config",
    "@constants": "src/constants",
    "@utils": "src/utils",
    "@services": "src/services",
    "@mechanics": "src/mechanics"
  },
  "lint-staged": {
    "*.{js,json,md,yml,yaml}": "prettier --write"
  }
}
