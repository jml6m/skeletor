{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "checkJs": true,
    "baseUrl": ".",
    "paths": {
      "@root/*": ["./*"],
      "@src/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@config": ["src/config/index.js"],
      "@services/*": ["src/services/*"],
      "@mechanics/*": ["src/mechanics/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules/*"]
}
